    "dev": "node --watch dist/index.js --foreground"
  },
  "dependencies": {
    "@rewter/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
